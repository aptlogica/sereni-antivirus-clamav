# ============================================
# Sereni Antivirus - Environment Variables
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Application Service Configuration
# ============================================

# Service host (0.0.0.0 for Docker/Kubernetes)
HOST=0.0.0.0

# Service port
PORT=8084

# CORS allowed origins (comma-separated)
# Production: https://api.example.com,https://app.example.com
# Development: * or http://localhost:3000
ALLOWED_ORIGINS=*

# ============================================
# Antivirus Provider Configuration
# ============================================

# Antivirus driver (currently only 'clamav' is supported)
ANTIVIRUS_DRIVER=clamav

# ============================================
# ClamAV Daemon Configuration
# ============================================

# ClamAV daemon address (host:port)
# Docker Compose: clamav:3310
# Local testing: 127.0.0.1:3310
# Kubernetes: clamav:3310
CLAMAV_ADDRESS=clamav:3310

# ClamAV scan timeout in seconds (increase for larger files)
CLAMAV_TIMEOUT_SECONDS=30

# ============================================
# File Upload Configuration
# ============================================

# Maximum upload file size in MB
# Default: 32 MB | Production: 256-512 MB
MAX_UPLOAD_SIZE_MB=32

# ============================================
# Persistent Volume Configuration
# ============================================

# Path for ClamAV database persistent volume
# Docker Compose local bind mount path
# Leave empty to use default (.clamav-db in project root)
CLAMAV_DB_PATH=.clamav-db

# ============================================
# Performance & Security Notes
# ============================================
#
# 1. For production:
#    - Restrict ALLOWED_ORIGINS to trusted domains
#    - Increase MAX_UPLOAD_SIZE_MB if needed
#    - Set CLAMAV_TIMEOUT_SECONDS=60-120 for large files
#    - Use persistent volumes for ClamAV database
#
# 2. ClamAV Database:
#    - ~500MB, persisted in volume
#    - Updated via freshclam daemon (12x/day by default)
#    - See PRODUCTION.md for persistent volume setup
#
# 3. Resource Requirements:
#    - ClamAV: 512MB-2GB RAM | Service: 256MB-512MB RAM
#    - See PRODUCTION.md for resource sizing
#
# Documentation:
#    - PRODUCTION.md - Production deployment guide
#    - DEPLOYMENT.md - Cloud platform deployment
#    - README.md - Quick start and features
