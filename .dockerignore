# Sensitive files - NEVER include in Docker images
.env
.env.*
*.env
.env.local
.env.*.local

# Git repository
.git
.gitignore
.gitattributes

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Documentation and non-runtime files
README.md
doc.md
report.md
*.md

# CI/CD files
Jenkinsfile
.github/
.gitlab-ci.yml

# Docker files
Dockerfile
docker-compose.yaml
.dockerignore

# Test files and coverage
tests/
*_test.go
coverage.out
*.test
.test_cache/

# Temporary files
tmp/
temp/
*.tmp
*.log
logs/

# Build artifacts (not needed in build stage)
bin/
dist/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Database files
*.db
*.sqlite
*.sqlite3

# Certificates (should be mounted at runtime, not baked in)
*.pem
*.key
*.crt
*.p12

# Air live reload
.air.toml

# Sonar files
sonar-project.properties
